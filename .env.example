# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional OCR settings
TESSERACT_LANG=eng
TESSERACT_CMD=
TESSDATA_PREFIX=

# Optional server setting for api.py
PORT=8080

# Optional retrieval behavior
# This enables the current LLM-based web research fallback. Leave disabled unless you explicitly want it.
ENABLE_WEB_RESEARCH=false
